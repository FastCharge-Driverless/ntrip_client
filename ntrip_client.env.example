# NTRIP client configuration.
# Copy to `ntrip_client.env`, fill in secrets, and `set -a; source ntrip_client.env; set +a`
# before running `ros2 launch ntrip_client ntrip_client_launch.py`.
# Any value left unset falls back to the default baked into the launch file.
# CLI args (e.g. host:=other.host) override these.

NTRIP_NAMESPACE=/
NTRIP_NODE_NAME=ntrip_client
NTRIP_DEBUG=true

# Caster connection
NTRIP_HOST=gnss-rtk.regione.abruzzo.it
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=0_RTCM_MSM
NTRIP_VERSION=2.0.0

# Authentication (keep the real values out of version control)
NTRIP_AUTHENTICATE=true
NTRIP_USERNAME=SapienzaFastCharge
NTRIP_PASSWORD=

# TLS (only used when NTRIP_SSL=True)
NTRIP_SSL=False
NTRIP_CERT=None
NTRIP_KEY=None
NTRIP_CA_CERT=None

NTRIP_RTCM_MESSAGE_PACKAGE=rtcm_msgs
